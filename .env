# GCP project with the Claude model enabled in Vertex AI Model Garden.
# Auth uses Application Default Credentials - run `gcloud auth application-default
# login`, or set GOOGLE_APPLICATION_CREDENTIALS to a service account key file.
GCP_PROJECT_ID=serverless-project-143
# Region where the Claude model is available on Vertex (Anthropic models are
# only offered in a subset of regions, e.g. us-east5, europe-west1).
GCP_LOCATION=global
# Model Garden model id for the enabled Claude Sonnet 5.5 deployment.
VERTEX_MODEL_NAME=claude-sonnet-5-5

# For a local broker (docker-compose), leave these as-is.
# For GCP Managed Service for Apache Kafka, set KAFKA_SECURITY_PROTOCOL=SASL_SSL
# and fetch the real bootstrap address (it's per-cluster, not a predictable
# string - see terraform/kafka.tf) once the cluster is ACTIVE with:
#   gcloud managed-kafka clusters describe <cluster_id> \
#     --project=<project> --location=<region> --format='value(bootstrapAddress)'
KAFKA_BOOTSTRAP_SERVERS=bootstrap-gjomj5xlb-tbpbb71zu3w.aba09531.us-central1.managedkafka.s.cloud.goog:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_TICKET_TOPIC=support-tickets
KAFKA_GROUP_ID=ticket-analyzer-agent

TICKETS_STORE_PATH=scripts/tickets.json
